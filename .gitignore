/stdseek
# 改名前的旧二进制名，留着免得历史产物被误提交
voidxo.exe
/voidxo

# 重编译时旧二进制会被改名成 stdseek~（运行中无法覆盖），这类备份一律不入库
/stdseek~
/voidxo~
*~
/tmpdata/
/data/
web/node_modules/
web/tsconfig.tsbuildinfo
shots/
/dist/

# 临时调试目录（tmpcheck / tmpcheck3 ...）
/tmpcheck*/

# 本地开发环境配置（MCP、编辑器）
/.mcp.json
web/.vscode/

# 内部资料：参考资产与规划文档只留本机，不入库
/参考/
/规划书/

# 数据库文件（data/ 已整体忽略，这里兜住散落的库文件）
*.db
*.db-shm
*.db-wal
*.bolt

# 前端构建中间产物（最终产物入库在 internal/webui/dist）
web/dist/
web/.ssr-build/
web/.angular/
web/shots/

# 临时测试数据（独立实例用的副本）
tmp/
